{
  "description": "Electron application with React, TypeScript, and Rspack",
  "scripts": {
    "dev": "concurrently --kill-others --names main,preload,renderer \"pnpm dev:main\" \"pnpm dev:preload\" \"pnpm dev:renderer\"",
    "dev:main": "cross-env NODE_OPTIONS=--experimental-transform-types NODE_ENV=development rspack build --config ./configs/rspack/rspack.main.config.ts --watch",
    "dev:preload": "cross-env NODE_OPTIONS=--experimental-transform-types NODE_ENV=development rspack build --config ./configs/rspack/rspack.preload.config.ts --watch",
    "dev:renderer": "cross-env NODE_OPTIONS=--experimental-transform-types NODE_ENV=development rspack serve --config ./configs/rspack/rspack.renderer.config.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "cross-env NODE_OPTIONS=--experimental-transform-types NODE_ENV=production rspack build --config ./configs/rspack/rspack.main.config.ts",
    "build:preload": "cross-env NODE_OPTIONS=--experimental-transform-types NODE_ENV=production rspack build --config ./configs/rspack/rspack.preload.config.ts",
    "build:renderer": "cross-env NODE_OPTIONS=--experimental-transform-types NODE_ENV=production rspack build --config ./configs/rspack/rspack.renderer.config.ts"
  },
  "devDependencies": {
    "@rspack/cli": "^2.1.8",
    "@rspack/core": "^2.1.8",
    "@rspack/dev-server": "^2.2.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "react-refresh": "^0.18.0"
  }
}
